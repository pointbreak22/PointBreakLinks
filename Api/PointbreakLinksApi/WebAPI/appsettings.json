{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "http://localhost:4200"
  ],
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=pointbreak_links;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Secret": "REPLACE_WITH_A_LONG_RANDOM_SECRET_IN_USER_SECRETS_OR_ENV_VARS",
    "Issuer": "PointBreakLinksApi",
    "Audience": "PointBreakLinksClient",
    "AccessTokenMinutes": 15
  },
  "Email": {
    "SmtpHost": "localhost",
    "SmtpPort": 2525,
    "FromAddress": "noreply@pointbreaklinks.local",
    "FromName": "PointbreakLinks"
  },
  "SiteReverification": {
    "IntervalHours": 24
  }
}
